{
  "name": "@netragate/design-system",
  "version": "0.12.1",
  "description": "Vue 3 design system with tokens, Tailwind CSS 4, light/dark mode, and 60+ components.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/design-system.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "components",
    "tailwindcss",
    "ui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/generate-icon-loaders.mjs && vite --config vite.playground.config.ts",
    "build:playground": "node scripts/generate-icon-loaders.mjs && vite build --config vite.playground.config.ts",
    "build": "node scripts/generate-icon-loaders.mjs && vue-tsc -p tsconfig.build.json --noEmit && vite build && vite build --config vite.playground.config.ts",
    "build:lib": "node scripts/generate-icon-loaders.mjs && vue-tsc -p tsconfig.build.json --noEmit && vite build",
    "generate:icons": "node scripts/generate-icon-loaders.mjs",
    "fix:lucide-imports": "node scripts/fix-lucide-imports.mjs",
    "fix:playground-imports": "node scripts/fix-playground-imports.mjs && node scripts/fix-playground-vue-imports.mjs",
    "analyze": "ANALYZE=true vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.37.0",
    "@vueuse/core": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "fast-check": "^3.22.0",
    "happy-dom": "^20.8.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.8"
  }
}
